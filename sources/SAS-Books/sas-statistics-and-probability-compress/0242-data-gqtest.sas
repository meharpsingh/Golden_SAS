data gqtest;
n1 = 20;
* sample size part 1;
n2 = 20;
* sample size part 2;
k = 2;
* number parameters;
sig2_1 = 3574.77;
* sig^2 in part 1;
sig2_2 = 12922;
* sig^2 in part 2;
gq = sig2_2/sig2_1;
* test statistic;
fc = finv(.95,n2-k,n1-k);
* F-critical one tail test;
pval = 1 - probf(gq,n2-k,n1-k);
* p-value one tail test;
run;
proc print data=gqtest;
title 'GQ test results';
run;
